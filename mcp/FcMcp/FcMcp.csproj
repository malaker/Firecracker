<Project Sdk="Microsoft.NET.Sdk">

  <!-- fc-mcp: stdio MCP server that exposes the sandbox as tools to host agents.
       A policy layer over fc.ps1; isolation comes from the existing backends. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>fc-mcp</AssemblyName>
    <RootNamespace>FcMcp</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="2.4.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FcMcp.Tests" />
  </ItemGroup>

</Project>
