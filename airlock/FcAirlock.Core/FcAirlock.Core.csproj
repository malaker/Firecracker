<Project Sdk="Microsoft.NET.Sdk">

  <!-- Rules, airlock output format, validator (runs inside the airlock VM) and unpacker
       (runs on the host). Shared by fc-airlock and the tests so both roles apply one rule set. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTrimmable>true</IsTrimmable>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="FcAirlock.Tests" />
  </ItemGroup>

</Project>
