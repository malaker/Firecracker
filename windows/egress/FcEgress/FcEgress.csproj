<Project Sdk="Microsoft.NET.Sdk">

  <!-- Host side: 'launch' (elevated) starts the guest relay session and the unprivileged 'serve' proxy. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>fc-egress</AssemblyName>
    <RootNamespace>FcEgress</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FcEgress.Core\FcEgress.Core.csproj" />
    <ProjectReference Include="..\..\common\FcWinToken\FcWinToken.csproj" />
  </ItemGroup>

</Project>
