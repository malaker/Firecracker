<Project Sdk="Microsoft.NET.Sdk">

  <!-- Guest side: HTTP proxy on 127.0.0.1 tunnelled over stdin/stdout of 'docker exec -i'.
       Published self-contained (single file, trimmed, win-x64) by setup so it runs on
       every Nano Server flavour without depending on the image's .NET runtime. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>fc-relay</AssemblyName>
    <RootNamespace>FcRelay</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\FcEgress.Core\FcEgress.Core.csproj" />
  </ItemGroup>

</Project>
