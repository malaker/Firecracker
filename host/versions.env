# Pinned upstream artifacts. Change a version only together with its checksum.
# Guest kernel/rootfs come from Firecracker's CI bucket; v1.15 is the newest
# CI directory that publishes them and they boot fine on newer Firecracker.

FC_VERSION="v1.17.0"
FC_URL="https://github.com/firecracker-microvm/firecracker/releases/download/${FC_VERSION}/firecracker-${FC_VERSION}-x86_64.tgz"
FC_SHA256="06094a1108ae9e82aa4c23a775aa92758f53f1175d422270d9d6162cb9ade558"

KERNEL_VERSION="6.1.155"
KERNEL_URL="https://s3.amazonaws.com/spec.ccfc.min/firecracker-ci/v1.15/x86_64/vmlinux-${KERNEL_VERSION}"
KERNEL_SHA256="e20e46d0c36c55c0d1014eb20576171b3f3d922260d9f792017aeff53af3d4f2"

ROOTFS_NAME="ubuntu-24.04"
ROOTFS_URL="https://s3.amazonaws.com/spec.ccfc.min/firecracker-ci/v1.15/x86_64/${ROOTFS_NAME}.squashfs"
ROOTFS_SHA256="68321e0482baeb3844dafe8a6b08a6902401a7afc41fbfd8c3d9ea08aadd244f"

# Size of the ext4 base image built from the squashfs.
ROOTFS_SIZE="2G"
