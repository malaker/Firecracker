# Pinned upstream artifacts. Change a version only together with its checksum.
# Guest kernel/rootfs come from Firecracker's CI bucket; v1.15 is the newest
# CI directory that publishes them and they boot fine on newer Firecracker.

FC_VERSION="v1.17.0"
FC_URL="https://github.com/firecracker-microvm/firecracker/releases/download/${FC_VERSION}/firecracker-${FC_VERSION}-x86_64.tgz"
FC_SHA256="06094a1108ae9e82aa4c23a775aa92758f53f1175d422270d9d6162cb9ade558"

KERNEL_VERSION="6.1.155"
KERNEL_URL="https://s3.amazonaws.com/spec.ccfc.min/firecracker-ci/v1.15/x86_64/vmlinux-${KERNEL_VERSION}"
KERNEL_SHA256="e20e46d0c36c55c0d1014eb20576171b3f3d922260d9f792017aeff53af3d4f2"

ROOTFS_NAME="ubuntu-24.04"
ROOTFS_URL="https://s3.amazonaws.com/spec.ccfc.min/firecracker-ci/v1.15/x86_64/${ROOTFS_NAME}.squashfs"
ROOTFS_SHA256="68321e0482baeb3844dafe8a6b08a6902401a7afc41fbfd8c3d9ea08aadd244f"

# Size of the ext4 base image built from the squashfs.
ROOTFS_SIZE="2G"

# Node.js for the agent image (in-sandbox-agents). The .tar.gz is used because the guest image has
# no xz; the checksum is from the release's SHASUMS256.txt.
NODE_VERSION="v24.22.2"
NODE_URL="https://nodejs.org/dist/${NODE_VERSION}/node-${NODE_VERSION}-linux-x64.tar.gz"
NODE_SHA256="361718c444e49af2ca5a110c83ba6a8901143f23ab285ebbef0341f391f482a9"

# Size of the sparse agent image (base image + Node.js + agent clients).
AGENT_ROOTFS_SIZE="6G"

# Analysis tools for the agent image (sandbox-recipes). The .deb files listed in
# images/agent/tools.lock come from this Ubuntu archive snapshot, so the URLs stay valid.
TOOLS_SNAPSHOT="20261101T000000Z"
TOOLS_SNAPSHOT_URL="https://snapshot.ubuntu.com/ubuntu/${TOOLS_SNAPSHOT}"

# pip for the agent image, as a wheel unpacked to /opt/pip (the checksum is PyPI's sha256).
PIP_VERSION="26.3"
PIP_URL="https://files.pythonhosted.org/packages/07/25/ee8c38ae72d66b844ce8eb9711ba905dba21ca1a8a0c960057c41cd23337/pip-${PIP_VERSION}-py3-none-any.whl"
PIP_SHA256="f3b60b20ffaadd4415ed7957212a38ac63fa4c5fa375bd0f4a797777940fad13"
