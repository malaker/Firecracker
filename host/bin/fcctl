#!/usr/bin/env bash
# fcctl - Firecracker security sandbox controller (runs as root inside fc-host).
set -euo pipefail

FC_HOME="${FC_HOME:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
for f in common state ssh net vm airlock agent doctor; do
  # shellcheck source=/dev/null
  . "$FC_HOME/lib/$f.sh"
done

usage() {
  cat <<'EOF'
Usage: fcctl <command> [options]

Commands:
  doctor [--boot]            Check that this host can run microVMs (--boot also boots a test VM)
  run --payload DIR --cmd CMD [vm options] [--results-dir DIR] [--run-info-file FILE]
                             Boot a VM, upload DIR to /work/in, run CMD in /work,
                             collect /work/out and logs into <results-dir>/<run-id>/, destroy the VM
  shell [vm options]         Boot a VM and open an interactive root shell; destroyed on exit
  start [vm options]         Boot a VM in the background and print its run id
  ssh <run-id> [command]     Open a shell or run a command in a started VM
  put <run-id> <host-path> [guest-dir]
                             Copy a host file, or a folder's contents, into a started VM
                             (default guest-dir /work/in)
  get <run-id> <guest-path> <local-dir>
                             Copy a guest file or folder out of a started VM through the
                             airlock into an empty or new local-dir (exit 1 if refused)
  list                       List VMs (running, dead or kept)
  stop <run-id>              Destroy a VM (a kept VM's disk is removed too)
  cleanup                    Destroy every VM and remove all leftovers from earlier runs

VM options:
  --net isolated|networked   Network mode (default: isolated = no network device)
  --allow CIDR[,CIDR...]     networked only: allow egress only to these destinations
  --vcpu N                   vCPUs (default 2)
  --mem MIB                  Memory in MiB (default 1024)
  --timeout DUR              Maximum lifetime, e.g. 90s, 30m, 1h (default 30m)
  --keep                     Keep the VM's disk after it stops, for inspection
  --image base|agent         Boot image (default base; agent = Node.js + agent clients)

Agent options (run and shell; Linux guests):
  --agent PROFILE            Run an AI agent: claude, codex or codex-ollama (agents/profiles.json)
  --prompt-file FILE         run: the task for the agent (headless)
  --model MODEL              Model to use (default: the profile's default; must match its allowlist)
  --agent-direct             Direct mode: no gateway, networked VM, real API key INSIDE the VM
  --token-budget N           Gateway token budget for this run (default from profiles.json)
  --key-ref REF              API key stashed with '_stash-key REF' (fc.ps1 does this)

Exit codes (run): the guest command's exit code, 124 on timeout, 125 on sandbox failure.
EOF
}

# --- option parsing ---------------------------------------------------------
OPT_NET=isolated OPT_ALLOW="" OPT_VCPU=$DEFAULT_VCPU OPT_MEM=$DEFAULT_MEM_MIB
OPT_TIMEOUT=$DEFAULT_TIMEOUT OPT_KEEP=0 OPT_PAYLOAD="" OPT_CMD="" OPT_RESULTS="$FC_RESULTS_DEFAULT"
OPT_BOOT=0 OPT_RUN_INFO="" OPT_IMAGE=base POSITIONAL=()
OPT_AGENT="" OPT_PROMPT_FILE="" OPT_MODEL="" OPT_AGENT_DIRECT=0 OPT_TOKEN_BUDGET="" OPT_KEY_REF=""

parse_opts() {
  while (( $# )); do
    case "$1" in
      --net)         OPT_NET="$2"; shift ;;
      --allow)       OPT_ALLOW="$2"; shift ;;
      --vcpu)        OPT_VCPU="$2"; shift ;;
      --mem)         OPT_MEM="$2"; shift ;;
      --timeout)     OPT_TIMEOUT="$(parse_duration "$2")" || die "invalid --timeout '$2'"; shift ;;
      --keep)        OPT_KEEP=1 ;;
      --payload)     OPT_PAYLOAD="$2"; shift ;;
      --cmd)         OPT_CMD="$2"; shift ;;
      --results-dir) OPT_RESULTS="$2"; shift ;;
      --run-info-file) OPT_RUN_INFO="$2"; shift ;;
      --image)       OPT_IMAGE="$2"; shift ;;
      --agent)       OPT_AGENT="$2"; shift ;;
      --prompt-file) OPT_PROMPT_FILE="$2"; shift ;;
      --model)       OPT_MODEL="$2"; shift ;;
      --agent-direct) OPT_AGENT_DIRECT=1 ;;
      --token-budget) OPT_TOKEN_BUDGET="$2"; shift ;;
      --key-ref)     OPT_KEY_REF="$2"; shift ;;
      --boot)        OPT_BOOT=1 ;;
      -h|--help)     usage; exit 0 ;;
      --*)           die "unknown option '$1'" ;;
      *)             POSITIONAL+=("$1") ;;
    esac
    shift
  done
  case "$OPT_NET" in isolated|networked) ;; *) die "--net must be 'isolated' or 'networked'" ;; esac
  if [ -n "$OPT_ALLOW" ]; then
    [ "$OPT_NET" = networked ] || die "--allow only applies to --net networked"
    local c o
    for c in ${OPT_ALLOW//,/ }; do
      [[ "$c" =~ ^([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})\.([0-9]{1,3})(/([0-9]{1,2}))?$ ]] \
        || die "invalid CIDR '$c' in --allow"
      # Reject out-of-range values here rather than as an nft error after the tap exists.
      for o in "${BASH_REMATCH[@]:1:4}"; do
        (( 10#$o <= 255 )) || die "invalid CIDR '$c' in --allow: octet $o is above 255"
      done
      [ -z "${BASH_REMATCH[6]}" ] || (( 10#${BASH_REMATCH[6]} <= 32 )) \
        || die "invalid CIDR '$c' in --allow: prefix /${BASH_REMATCH[6]} is above 32"
    done
  fi
  (( OPT_TIMEOUT > 0 )) || die "--timeout must be positive"
  if [ -n "$OPT_AGENT" ]; then
    agent_check_opts
  elif (( OPT_AGENT_DIRECT )) || [ -n "$OPT_PROMPT_FILE$OPT_MODEL$OPT_TOKEN_BUDGET" ]; then
    die "--agent-direct, --prompt-file, --model and --token-budget need --agent"
  fi
}

# Boot a VM with the parsed options; prints nothing, sets VM_ID.
boot_vm() {
  boot_vm_with "$OPT_VCPU" "$OPT_MEM" "$OPT_NET" "$OPT_ALLOW" "$1" "$OPT_KEEP" vm "" "$OPT_IMAGE"
}

# --- commands ---------------------------------------------------------------
cmd_run() {
  if [ -n "$OPT_AGENT" ]; then
    # Agent run (spec: sandbox-agents): the task comes from the prompt file, the payload is optional.
    [ -z "$OPT_CMD" ] || die "use either --cmd or --agent, not both"
    [ -n "$OPT_PROMPT_FILE" ] && [ -s "$OPT_PROMPT_FILE" ] || die "an agent run needs a non-empty --prompt-file"
    (( $(stat -c %s "$OPT_PROMPT_FILE") <= 1048576 )) || die "the prompt is larger than 1 MiB"
    [ -z "$OPT_PAYLOAD" ] || [ -d "$OPT_PAYLOAD" ] || die "payload directory '$OPT_PAYLOAD' not found"
    OPT_CMD="fc-agent headless"
  else
    [ -n "$OPT_CMD" ] || die "run needs --cmd"
    [ -n "$OPT_PAYLOAD" ] && [ -d "$OPT_PAYLOAD" ] || die "payload directory '$OPT_PAYLOAD' not found"
  fi

  local started rc=0 timed_out=false error="" out t0 elapsed
  started="$(now_iso)"
  boot_vm $(( OPT_TIMEOUT + COLLECT_GRACE ))
  out="$OPT_RESULTS/$VM_ID"
  mkdir -p "$out/out"
  trap 'vm_destroy "$VM_ID"' EXIT
  [ -z "$OPT_AGENT" ] || meta_set "$VM_ID" gateway_keep_log true
  # Written up front (no end time yet) so the watchdog can finalise it if
  # this controller dies before the run ends.
  write_run_meta "$out" "$started" null false ""
  meta_set_str "$VM_ID" results_dir "$out"
  [ -z "$OPT_RUN_INFO" ] || write_run_info "$OPT_RUN_INFO" "$out"

  if [ -n "$OPT_PAYLOAD" ] && ! upload_dir "$VM_ID" "$OPT_PAYLOAD" /work/in; then
    rc=$EXIT_INFRA error="payload upload failed"
  elif [ -n "$OPT_AGENT" ] && ! agent_prepare_guest "$VM_ID" "$OPT_PROMPT_FILE"; then
    rc=$EXIT_INFRA error="could not prepare the agent in the guest"
  else
    fc_ssh "$VM_ID" "mkdir -p /work/out" </dev/null || true
    log "running: $OPT_CMD"
    t0=$(mono_ms)
    set +e
    timeout -k 10 "$OPT_TIMEOUT" \
      bash -c 'fc_ssh "$@"' _ "$VM_ID" "cd /work && $OPT_CMD" </dev/null \
      > >(tee "$out/stdout.log") 2> >(tee "$out/stderr.log" >&2)
    rc=$?
    set -e
    elapsed=$(( $(mono_ms) - t0 ))
    # Monotonic: a wall-clock adjustment must not turn a real timeout into a plain exit 124.
    if (( rc == 124 || rc == 137 )) && (( elapsed >= OPT_TIMEOUT * 1000 - 100 )); then
      rc=$EXIT_TIMEOUT timed_out=true
      log "timed out after ${OPT_TIMEOUT}s"
    elif (( rc == 255 )) && ! vm_alive "$VM_ID"; then
      rc=$EXIT_INFRA error="VM died during the run"
    fi
  fi
  # Output leaves the guest only through the airlock (spec: guest-output-airlock). The source
  # VM is destroyed as soon as its bytes are on the host; a refused collection keeps the
  # guest's exit code and is recorded in meta.json.
  airlock_transfer "$VM_ID" /work/out "$out/out" release_run_vm || true
  local agent_json=null
  if [ -n "$OPT_AGENT" ]; then
    # The gateway stopped with the VM; its log and totals go into the results, then its folder goes.
    local gw="$FC_GATEWAY_DIR/$VM_ID"
    [ -f "$gw/llm.log" ] && cp "$gw/llm.log" "$out/llm.log"
    agent_json="$(agent_meta_json "$gw/totals.json")"
    gateway_discard "$VM_ID"
  fi
  echo "$rc" > "$out/exit_code"
  write_run_meta "$out" "$started" "$rc" "$timed_out" "$error" "$(collection_json)" "$agent_json"
  [ -z "$error" ] || log "error: $error"
  log "results: $out (exit code $rc)"
  exit "$rc"
}

# Destroys the run's VM once its output has been pulled, and drops the EXIT trap: a second
# vm_destroy would delete a disk that --keep just preserved.
release_run_vm() {
  trap - EXIT
  vm_destroy "$VM_ID"
}

# The airlock_transfer result as the meta.json "collection" object.
collection_json() {
  jq -n --arg s "$AIRLOCK_STATUS" --arg r "$AIRLOCK_REASON" \
    --argjson f "${AIRLOCK_FILES:-0}" --argjson b "${AIRLOCK_BYTES:-0}" \
    '{status:$s, reason:(if $r == "" then null else $r end), files:$f, bytes:$b}'
}

# write_run_info <file> <results-dir>: tells a caller (the MCP server) which run this is,
# as soon as the VM has an id. results_dir is given as a Windows path.
write_run_info() {
  local win
  win="$(wslpath -w "$2" 2>/dev/null || echo "$2")"
  jq -n --arg id "$VM_ID" --arg dir "$win" '{run_id:$id, results_dir:$dir}' > "$1.tmp" && mv "$1.tmp" "$1" \
    || log "warning: could not write the run info file $1"
}

# write_run_meta <dir> <started> <exit-code|null> <timed-out> <error> [collection-json] [agent-json]
# An exit code of null means the run is still in progress (no ended_at).
write_run_meta() {
  jq -n --arg id "$VM_ID" --arg cmd "$OPT_CMD" --arg payload "$OPT_PAYLOAD" --arg net "$OPT_NET" \
    --arg allow "$OPT_ALLOW" --argjson vcpu "$OPT_VCPU" --argjson mem "$OPT_MEM" \
    --argjson timeout "$OPT_TIMEOUT" --arg started "$2" --arg ended "$(now_iso)" \
    --argjson rc "$3" --argjson timed_out "$4" --arg error "$5" \
    --arg fc "${FC_VERSION:-}" --argjson keep "$OPT_KEEP" --argjson collection "${6:-null}" \
    --argjson agent "${7:-null}" \
    '{run_id:$id, command:$cmd, payload:$payload, net:$net, allow:$allow, vcpu:$vcpu,
      mem_mib:$mem, timeout_sec:$timeout, started_at:$started,
      ended_at:(if $rc == null then null else $ended end),
      exit_code:$rc, timed_out:$timed_out, error:(if $error == "" then null else $error end),
      keep_disk:($keep==1), firecracker:$fc, collection:$collection}
     + (if $agent == null then {} else {agent:$agent} end)' > "$1/meta.json"
}

# `timeout` runs fc_ssh through `bash -c`, which needs these exported.
export -f fc_ssh vsock_path
export FC_SSH_KEY FC_HOME FC_JAIL_BASE

cmd_shell() {
  boot_vm "$OPT_TIMEOUT"
  trap 'vm_destroy "$VM_ID"' EXIT
  if [ -n "$OPT_AGENT" ]; then
    agent_prepare_guest "$VM_ID" || die "could not prepare the agent in the guest"
    log "agent VM $VM_ID ready ($AGENT_PROFILE, $AGENT_MODE mode); run 'fc-agent interactive'; exit the shell to destroy it"
    set +e
    fc_ssh "$VM_ID" -t 'eval "$(fc-agent env)"; cd /work; exec bash -i'
    set -e
    return
  fi
  log "VM $VM_ID ready; exit the shell to destroy it"
  set +e
  fc_ssh "$VM_ID" -t
  set -e
}

cmd_start() {
  [ -z "$OPT_AGENT" ] || die "--agent works with run and shell, not start"
  boot_vm "$OPT_TIMEOUT"
  echo "$VM_ID"
}

cmd_ssh() {
  local id="${POSITIONAL[0]:-}"
  [ -n "$id" ] && vm_exists "$id" && vm_alive "$id" || die "no running VM '$id'"
  if (( ${#POSITIONAL[@]} > 1 )); then
    fc_ssh "$id" "${POSITIONAL[@]:1}"
  else
    fc_ssh "$id" -t
  fi
}

# A started VM that put/get may use: running, and not an airlock.
require_session_vm() {
  local id="$1"
  [ -n "$id" ] && vm_exists "$id" && vm_alive "$id" || die "no running VM '$id'"
  [ "$(meta_get "$id" role)" != airlock ] || die "VM '$id' is an airlock"
}

# put <run-id> <host-path> [guest-dir]: copies a host file, or a folder's contents, into the
# guest (default /work/in). Host data is trusted, so the guest unpacks it with its own tar.
cmd_put() {
  local id="${POSITIONAL[0]:-}" src="${POSITIONAL[1]:-}" gdir="${POSITIONAL[2]:-/work/in}" qdir
  require_session_vm "$id"
  [ -n "$src" ] && [ -e "$src" ] || die "host path '$src' not found"
  printf -v qdir '%q' "$gdir"
  if [ -d "$src" ]; then
    tar -C "$src" -cf - . | fc_ssh "$id" "mkdir -p $qdir && tar -C $qdir --no-same-owner -xf -" \
      || die "copy into $gdir failed"
  else
    tar -C "$(dirname -- "$src")" -cf - -- "$(basename -- "$src")" \
      | fc_ssh "$id" "mkdir -p $qdir && tar -C $qdir --no-same-owner -xf -" || die "copy into $gdir failed"
  fi
  log "copied $src into $gdir"
}

# get <run-id> <guest-path> <local-dir>: copies a guest file or folder out through the airlock.
# local-dir must not exist or be empty. Exit 1 when the airlock refuses the files.
cmd_get() {
  local id="${POSITIONAL[0]:-}" gpath="${POSITIONAL[1]:-}" dest="${POSITIONAL[2]:-}"
  require_session_vm "$id"
  [ -n "$gpath" ] || die "get needs a guest path"
  [ -n "$dest" ] || die "get needs a local destination folder"
  if airlock_transfer "$id" "$gpath" "$dest" "" error; then
    log "copied $AIRLOCK_FILES files ($AIRLOCK_BYTES bytes) from $gpath to $dest"
    return 0
  fi
  case "$AIRLOCK_STATUS" in
    refused) exit 1 ;;
    *) case "$AIRLOCK_REASON" in "guest path"*) exit 1 ;; *) exit "$EXIT_INFRA" ;; esac ;;
  esac
}

cmd_list() {
  local id state role allow
  printf '%-22s %-8s %-10s %-5s %-7s %-20s %-18s %s\n' RUN-ID STATE NET VCPU MEM STARTED ALLOW ROLE
  for id in $(list_vm_ids); do
    state="$(meta_get "$id" state)"
    if [ "$state" != kept ] && ! vm_alive "$id"; then state=dead; fi
    role="$(meta_get "$id" role)"
    case "$role" in airlock) role="airlock:$(meta_get "$id" parent)" ;; *) role=vm ;; esac
    allow="$(meta_get "$id" allow)"
    printf '%-22s %-8s %-10s %-5s %-7s %-20s %-18s %s\n' "$id" "$state" "$(meta_get "$id" net)" \
      "$(meta_get "$id" vcpu)" "$(meta_get "$id" mem_mib)M" "$(meta_get "$id" started_at)" \
      "${allow:--}" "$role"
  done
}

cmd_stop() {
  local id="${POSITIONAL[0]:-}"
  [ -n "$id" ] && { vm_exists "$id" || [ -d "$(jail_dir "$id")" ]; } || die "unknown VM '$id'"
  vm_destroy "$id" 1
  log "stopped $id"
}

cmd_cleanup() {
  local id pid d tap chain root
  for id in $(list_vm_ids); do vm_destroy "$id" 1; done
  # Orphans that have no state left (e.g. the controller was killed mid-start).
  for pid in $(pgrep -x firecracker || true); do
    # The jailer pivots into the jail, so its root mount's source is the jail dir.
    root="$(awk '$5 == "/" {print $4; exit}' "/proc/$pid/mountinfo" 2>/dev/null || true)"
    case "$root" in "$FC_JAIL_BASE"/*) kill -KILL "$pid" 2>/dev/null || true ;; esac
  done
  for pid in $(pgrep -f "fcctl'? _expire" || true); do kill "$pid" 2>/dev/null || true; done
  sleep 0.3
  for d in "$FC_JAIL_BASE"/firecracker/*/; do [ -d "$d" ] && rm -rf "$d"; done
  for d in /sys/fs/cgroup/"$FC_CGROUP_PARENT"/*/; do [ -d "$d" ] && rmdir "$d" 2>/dev/null || true; done
  for tap in $(ip -o link show 2>/dev/null | awk -F': ' '{print $2}' | cut -d@ -f1 | grep "^$FC_TAP_PREFIX" || true); do
    net_down "${tap#"$FC_TAP_PREFIX"}"
  done
  for chain in $(nft list table $FC_NFT_TABLE 2>/dev/null | awk '$1=="chain" && $2 ~ /^vm-/ {print $2}'); do
    net_down "${chain#vm-}"
  done
  rm -rf "${FC_VMS:?}"/*
  # Airlock leftovers: host-side readers (their uid range) and transfer staging folders.
  for pid in $(ps -eo uid=,pid= | awk -v lo="$FC_UNPACK_UID_BASE" -v hi="$(( FC_UNPACK_UID_BASE + FC_UNPACK_UID_COUNT ))" \
      '$1 >= lo && $1 < hi {print $2}'); do
    kill -KILL "$pid" 2>/dev/null || true
  done
  [ -d "$FC_STAGING" ] && find "${FC_STAGING:?}" -mindepth 1 -delete 2>/dev/null || true
  # LLM gateways (their uid range), their sockets and logs, and any stashed provider keys.
  for pid in $(ps -eo uid=,pid= | awk -v lo="$FC_GATEWAY_UID_BASE" -v hi="$(( FC_GATEWAY_UID_BASE + FC_MAX_SLOTS ))" \
      '$1 >= lo && $1 < hi {print $2}'); do
    kill -KILL "$pid" 2>/dev/null || true
  done
  [ -d "$FC_GATEWAY_DIR" ] && find "${FC_GATEWAY_DIR:?}" -mindepth 1 -delete 2>/dev/null || true
  [ -d "$FC_KEYS" ] && find "${FC_KEYS:?}" -mindepth 1 -delete 2>/dev/null || true
  log "cleanup complete"
}

# Internal: called by the watchdog when a VM's lifetime is over.
cmd_expire() {
  local id="${POSITIONAL[0]:-}"
  vm_exists "$id" || exit 0
  [ "$(meta_get "$id" state)" = kept ] && exit 0
  log "VM $id reached its timeout; destroying"
  meta_set "$id" timed_out true
  # Finalise the results of a run whose controller is gone.
  local res
  res="$(meta_get "$id" results_dir)"
  if [ -n "$res" ] && [ -f "$res/meta.json" ] && [ "$(jq -r '.ended_at' "$res/meta.json")" = null ]; then
    jq --arg ended "$(now_iso)" --argjson rc "$EXIT_TIMEOUT" \
      '.ended_at = $ended | .exit_code = $rc | .timed_out = true
       | .error = "controller exited before the run finished; stopped by the watchdog"' \
      "$res/meta.json" > "$res/meta.json.tmp" && mv "$res/meta.json.tmp" "$res/meta.json"
    echo "$EXIT_TIMEOUT" > "$res/exit_code"
  fi
  vm_destroy "$id"
}

# --- main -------------------------------------------------------------------
main() {
  # fc.ps1 passes all arguments as one base64 blob of NUL-separated values,
  # which avoids wsl.exe re-quoting commands that contain spaces or quotes.
  if [ "${1:-}" = "--argv-b64" ]; then
    local decoded=()
    mapfile -d '' decoded < <(printf '%s' "$2" | base64 -d)
    set -- "${decoded[@]}"
  fi
  local cmd="${1:-}"; shift || true
  case "$cmd" in ""|-h|--help|help) usage; exit 0 ;; esac
  require_root
  parse_opts "$@"
  case "$cmd" in
    doctor)  doctor "$OPT_BOOT" ;;
    run)     cmd_run ;;
    shell)   cmd_shell ;;
    start)   cmd_start ;;
    ssh)     cmd_ssh ;;
    put)     cmd_put ;;
    get)     cmd_get ;;
    list)    cmd_list ;;
    stop)    cmd_stop ;;
    cleanup) cmd_cleanup ;;
    _expire) cmd_expire ;;
    _stash-key) cmd_stash_key ;;
    _drop-key) cmd_drop_key ;;
    *) usage >&2; exit 2 ;;
  esac
}

main "$@"
